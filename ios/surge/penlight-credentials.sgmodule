#!name=Penlight Dream Box - UID UUID
#!desc=从 Garupa 请求中本地捕获 UID 与 X-Signature(UUID)
#!system=iOS
#!homepage=https://github.com/Lanyinn-Labs/Penlight-Dream-Box

[Script]
penlight-credentials-capture = type=http-request,pattern=^https:\/\/api\.garupa\.jp\/api\/user\/[0-9]+(?:[\/?]|$),requires-body=false,engine=jsc,script-path=https://raw.githubusercontent.com/Lanyinn-Labs/Penlight-Dream-Box/main/ios/common/penlight-credentials.js,argument=capture,timeout=10
penlight-credentials-show = type=generic,engine=jsc,script-path=https://raw.githubusercontent.com/Lanyinn-Labs/Penlight-Dream-Box/main/ios/common/penlight-credentials.js,argument=show,timeout=10

[MITM]
hostname = %APPEND% api.garupa.jp
