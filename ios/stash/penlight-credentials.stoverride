name: 'Penlight Dream Box - UID UUID'
desc: |-
  从 Garupa 请求中本地捕获 UID 与 X-Signature(UUID)。
  不修改游戏请求，也不上传请求内容或加密配置。
author: 'Penlight Dream Box'
homepage: 'https://github.com/Lanyinn-Labs/Penlight-Dream-Box'
version: '1.0.0'

http:
  mitm:
    - api.garupa.jp
  script:
    - name: penlight-credentials-capture
      match: '^https://api\.garupa\.jp/api/user/[0-9]+(?:[/?]|$)'
      type: request
      engine: jsc
      timeout: 10
      argument: capture

script-providers:
  penlight-credentials-capture:
    url: https://raw.githubusercontent.com/Lanyinn-Labs/Penlight-Dream-Box/main/ios/common/penlight-credentials.js
    interval: 86400
  penlight-credentials-show:
    url: https://raw.githubusercontent.com/Lanyinn-Labs/Penlight-Dream-Box/main/ios/common/penlight-credentials.js
    interval: 86400

tiles:
  - name: penlight-credentials-show
    argument: show
    interval: 86400
    title: '显示已保存 UID / UUID'
    content: '点击刷新后查看本机保存的数据'
    icon: doc.on.clipboard
    backgroundColor: '#1d1d1f'
