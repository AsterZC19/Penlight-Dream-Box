#!name = Penlight Dream Box - UID UUID
#!desc = 远程加载脚本，从自有 BanG Dream 日服请求中本地捕获 UID 与 X-Signature(UUID)
#!author = Penlight Dream Box
#!homepage = https://github.com/Lanyinn-Labs/Penlight-Dream-Box
#!system = iOS,iPadOS

[Script]
http-request ^https:\/\/api\.garupa\.jp\/api\/user\/[0-9]+(?:[\/?]|$) script-path=https://raw.githubusercontent.com/Lanyinn-Labs/Penlight-Dream-Box/main/ios/common/penlight-credentials.js,argument="capture",timeout=10,tag=获取 Garupa UID UUID
generic script-path=https://raw.githubusercontent.com/Lanyinn-Labs/Penlight-Dream-Box/main/ios/common/penlight-credentials.js,argument="show",timeout=10,tag=显示已保存 UID UUID

[MITM]
hostname = api.garupa.jp
