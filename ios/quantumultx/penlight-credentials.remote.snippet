# Quantumult X remote resource for one-tap installation.
# The shared script is loaded from the repository, so no local file copy is required.
^https:\/\/api\.garupa\.jp\/api\/user\/[0-9]+(?:[\/?]|$) url script-request-header https://raw.githubusercontent.com/Lanyinn-Labs/Penlight-Dream-Box/main/ios/common/penlight-credentials.js
