# Penlight Dream Box 环境变量模板，docker 与裸部署共用
# cp .env.example .env 后填写

# install.sh 下载来源，默认 GitHub Release
# BOX_REPO=AsterZC19/Penlight-Dream-Box
# DREAM_API_REPO=AsterZC19/Penlight-Dream-API
# ARCH=linux-x86_64

# --- Box ---
BOX_HOST=0.0.0.0
BOX_PORT=8081
BOX_API_PREFIX=/api
DREAM_API_BASE=http://127.0.0.1:8080/api
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=penlight_box
# 小内存 VPS 建议 300
POLL_INTERVAL_SECS=300
MASTER_INTERVAL_SECS=3600
POST_END_WINDOW_SECS=3600
# 可选 API 密钥，设置后所有 /api/* 请求需带 X-API-Key 或 Authorization: Bearer
API_KEY=

# --- Dream-API ---
HOST=0.0.0.0
PORT=8080
API_PREFIX=/api
LOG_LEVEL=info
GARUPA_SERVER_BASES=api.garupa.jp
# 以下凭据必须填写真实值
GARUPA_UIDS=
GARUPA_UUIDS=
GARUPA_ENCRYPTION_KEYS=
GARUPA_ENCRYPTION_IVS=
GARUPA_CLIENT_PLATFORMS=iOS
